# Email Service Configuration
# Copy this file to .env.local (for Vercel) or set in your hosting platform's environment variables

# SendGrid Configuration (for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@wcdmr.com
FROM_NAME=WCDMR 2026

# Alternative: SMTP Configuration (if using Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Stripe Configuration (if using backend for PaymentIntents)
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
